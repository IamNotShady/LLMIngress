# Copy this file to .env.local for local development.
# Test scripts load .env first, then .env.local if it exists.
# Variables already set in the shell take precedence over both files.

# Database
# Local pnpm/dev against a published Compose Postgres uses the compose password:
# DATABASE_URL=postgresql://postgres:llmi-local-db@127.0.0.1:55432/postgres
TEST_DATABASE_URL=postgresql://postgres:llmi-local-db@127.0.0.1:55432/postgres
DATABASE_URL=postgresql://postgres:llmi-local-db@127.0.0.1:55432/postgres

# Secret encryption for provider credentials.
# Compose: ./scripts/deploy.sh writes a random ENCRYPTION_KEY into gitignored .env when missing.
# Local pnpm: set ENCRYPTION_KEY in .env.local, or generate with:
#   openssl rand -base64 32
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=

# Bootstrap config file override
LLMINGRESS_BOOTSTRAP_CONFIG=

# Local service ports and host
GATEWAY_PORT=4000
CONSOLE_PORT=3000
CONSOLE_HOST=127.0.0.1
GATEWAY_PUBLISH_HOST=127.0.0.1
CONSOLE_PUBLISH_HOST=127.0.0.1
POSTGRES_PUBLISH_HOST=127.0.0.1
WORKER_HEARTBEAT_MS=30000
WORKER_JOB_LEASE_MS=60000
WORKER_SHUTDOWN_GRACE_MS=25000
WORKER_ID=

# Gateway runtime behavior
GATEWAY_CONFIG_NOTIFICATIONS=true
GATEWAY_CONFIG_RECONCILE_INTERVAL_MS=30000
GATEWAY_CORS_ALLOWED_ORIGINS=
GATEWAY_DEBUG_REQUEST_METADATA=false
# Compose single-app container default (Console playground / sidebar Gateway URL).
GATEWAY_URL=http://127.0.0.1:4000
GATEWAY_SHUTDOWN_DRAIN_MS=10000
GATEWAY_READINESS_TIMEOUT_MS=1000

# Opt-in real provider smoke test. Keep disabled unless you want live API calls.
LLMINGRESS_REAL_SMOKE=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local init.sh convenience
SKIP_VERIFY=0
