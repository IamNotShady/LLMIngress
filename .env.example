# Copy this file to .env for checkout defaults or .env.local for local overrides.
# All supported startup commands use: shell > .env.local > .env > code defaults.
# Values with built-in defaults stay commented so copying this file creates no needless overrides.

# Shared service endpoints
# GATEWAY_PORT=4000
# CONSOLE_PORT=3000
# Optional public URL for Console links and browser requests.
# Defaults to http://127.0.0.1:<GATEWAY_PORT>.
# GATEWAY_URL=https://gateway.example.com

# Shared security and runtime
# Docker deploy generates ENCRYPTION_KEY in .env when that file does not contain one.
# Local init.sh/pnpm dev requires ENCRYPTION_KEY or ENCRYPTION_KEY_FILE.
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_FILE=/absolute/path/to/encryption-key
# LOG_LEVEL=info
# LLMINGRESS_DB_POOL_MAX=10
# PROVIDER_REQUEST_TIMEOUT_MS=30000

# Docker Compose
# Published host ports; change them per branch when running stacks concurrently.
# POSTGRES_PORT=55432
# POSTGRES_PUBLISH_HOST=127.0.0.1
# CONSOLE_PUBLISH_HOST=127.0.0.1
# GATEWAY_PUBLISH_HOST=127.0.0.1
# Docker-internal database connection. Usually leave unset so the app uses postgres:5432.
# COMPOSE_DATABASE_URL=postgresql://postgres:llmi-local-db@postgres:5432/postgres

# Local init.sh and pnpm dev
# These host processes connect through the PostgreSQL port published above.
# If POSTGRES_PORT changes, update both host connection URLs to the same port.
DATABASE_URL=postgresql://postgres:llmi-local-db@127.0.0.1:55432/postgres
# CONSOLE_HOST=127.0.0.1
# GATEWAY_HOST=127.0.0.1
# Optional JSON bootstrap config file.
# LLMINGRESS_BOOTSTRAP_CONFIG=/absolute/path/to/bootstrap.json
# init.sh only: skip its verify gate for a fast local restart.
# SKIP_VERIFY=1

# Tests
# Keep this separate from DATABASE_URL so tests cannot target a production database accidentally.
TEST_DATABASE_URL=postgresql://postgres:llmi-local-db@127.0.0.1:55432/postgres

# Gateway
# GATEWAY_BODY_LIMIT_BYTES=10485760
# GATEWAY_STREAM_CONNECT_TIMEOUT_MS=10000
# GATEWAY_STREAM_IDLE_TIMEOUT_MS=120000
# GATEWAY_CONFIG_NOTIFICATIONS=true
# GATEWAY_CONFIG_RECONCILE_INTERVAL_MS=30000
# GATEWAY_CORS_ALLOWED_ORIGINS=https://console.example.com
# GATEWAY_DEBUG_REQUEST_METADATA=false
# GATEWAY_SHUTDOWN_DRAIN_MS=10000
# GATEWAY_READINESS_TIMEOUT_MS=1000
# GATEWAY_BREAKER_ENABLED=true
# GATEWAY_BREAKER_ERROR_THRESHOLD_PERCENT=50
# GATEWAY_BREAKER_WINDOW_MS=60000
# GATEWAY_BREAKER_MIN_REQUESTS=5
# GATEWAY_BREAKER_HALF_OPEN_AFTER_MS=30000
# GATEWAY_BREAKER_HALF_OPEN_CALLS=3
# GATEWAY_PROVIDER_RETRIES=2
# GATEWAY_PROVIDER_RETRY_INITIAL_DELAY_MS=200
# GATEWAY_HEALTH_SUMMARY_CACHE_TTL_MS=5000

# Worker
# WORKER_HEARTBEAT_MS=30000
# WORKER_JOB_LEASE_MS=60000
# WORKER_SHUTDOWN_GRACE_MS=25000
# WORKER_MAX_JOB_DURATION_MS=300000
# WORKER_ID=worker-1
# In-memory model-catalog cache TTL; 0 disables the cache.
# WORKER_MODEL_CATALOG_CACHE_TTL_MS=1800000
# WORKER_ACTIVITY_RETENTION_DAYS=30
# WORKER_HEALTH_EVENT_RETENTION_DAYS=30
# WORKER_JOB_RETENTION_DAYS=7
# RETENTION_CLEANUP_INTERVAL_MS=86400000

# Provider OAuth
# Optional client-id overrides; built-in defaults are used when unset.
# GROK_OAUTH_CLIENT_ID=
# MINIMAX_OAUTH_CLIENT_ID=
