{
  "name": "llmingress",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "tsx scripts/run-with-env.ts vitest run",
    "test:e2e": "tsx scripts/run-with-env.ts playwright test",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "verify:features": "tsx scripts/run-with-env.ts node scripts/verify-features.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:check": "tsx scripts/run-with-env.ts tsx scripts/migrate-check.ts",
    "init": "bash init.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
