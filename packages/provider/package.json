{
  "name": "@llmingress/provider",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./anthropic": {
      "types": "./src/adapters/anthropic.ts",
      "default": "./src/adapters/anthropic.ts"
    },
    "./authenticated-http": {
      "types": "./src/authenticated-http.ts",
      "default": "./src/authenticated-http.ts"
    },
    "./connectivity": {
      "types": "./src/connectivity.ts",
      "default": "./src/connectivity.ts"
    },
    "./descriptor": {
      "types": "./src/descriptor.ts",
      "default": "./src/descriptor.ts"
    },
    "./dialect": {
      "types": "./src/dialect.ts",
      "default": "./src/dialect.ts"
    },
    "./headers": {
      "types": "./src/headers.ts",
      "default": "./src/headers.ts"
    },
    "./model-list": {
      "types": "./src/model-list.ts",
      "default": "./src/model-list.ts"
    },
    "./oauth": {
      "types": "./src/oauth.ts",
      "default": "./src/oauth.ts"
    },
    "./openai": {
      "types": "./src/adapters/openai.ts",
      "default": "./src/adapters/openai.ts"
    },
    "./openrouter": {
      "types": "./src/adapters/openrouter.ts",
      "default": "./src/adapters/openrouter.ts"
    },
    "./subscription-adapters": {
      "types": "./src/adapters/subscription.ts",
      "default": "./src/adapters/subscription.ts"
    },
    "./price-source": {
      "types": "./src/price-source.ts",
      "default": "./src/price-source.ts"
    },
    "./subscription": {
      "types": "./src/subscription.ts",
      "default": "./src/subscription.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@llmingress/domain": "workspace:*",
    "@llmingress/util": "workspace:*"
  }
}
